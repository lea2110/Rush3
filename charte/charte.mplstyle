# Charte graphique Rush 3 — style matplotlib (voir CHARTE.md)

font.family: sans-serif
font.sans-serif: Inter, Helvetica Neue, Helvetica, Arial, DejaVu Sans
font.size: 13
font.weight: normal

figure.facecolor: FFFFFF
figure.figsize: 10, 5.6
figure.dpi: 110
savefig.dpi: 200
savefig.bbox: tight
savefig.facecolor: FFFFFF

axes.facecolor: FFFFFF
axes.edgecolor: D9D9D9
axes.linewidth: 1
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.titlesize: 20
axes.titleweight: bold
axes.titlelocation: left
axes.titlepad: 16
axes.labelsize: 13
axes.labelcolor: 000000
axes.labelweight: bold
axes.grid: True
axes.grid.axis: x
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['0055FF', 'FF6B00', '009925', 'A88565', 'FFB3C9', 'FFDC00'])

grid.color: EDEDED
grid.linewidth: 1

xtick.color: 000000
ytick.color: 000000
xtick.labelsize: 12
ytick.labelsize: 12
xtick.major.size: 0
ytick.major.size: 0

legend.frameon: False
legend.fontsize: 12

lines.linewidth: 3
patch.linewidth: 0
text.color: 000000
